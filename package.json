{
  "name": "@hirakinii-packages/ror-api-typescript",
  "version": "0.2.0",
  "description": "Type-safe TypeScript client for the Research Organization Registry (ROR) REST API v2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0 <12",
      "onFail": "error"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "lint": "eslint '{src,tests,examples}/**/*.ts'",
    "format": "prettier --write '{src,tests,examples}/**/*.ts'",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirakinii/ror-api-typescript.git"
  },
  "keywords": [],
  "author": "hirakinii & Claude",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/hirakinii/ror-api-typescript/issues"
  },
  "homepage": "https://github.com/hirakinii/ror-api-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
